GEMINI_API_KEY=your_gemini_api_key
PORT=4174

# Embeddings use models/gemini-embedding-001 through the Gemini API.
#
# Optional local/free vector DB.
# Run Qdrant locally, then keep this URL:
# docker run -p 6333:6333 qdrant/qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=zuno_business_memory

# Only needed for Qdrant Cloud.
# QDRANT_API_KEY=your_qdrant_cloud_api_key
